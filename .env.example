# Copy to .env (gitignored). The bot reads it from the repo root; set variables win.
# Only OPENAI_API_KEY is required. Every other key makes the show better, and has a stand-in
# when it's missing. docs/KEYS.md says where to get each.

OPENAI_API_KEY=       # required (except in rehearsal): every line, the writers' room
FIRECRAWL_API_KEY=    # reads pages properly (JavaScript, screenshots); without: a plain fetch
CARTESIA_API_KEY=     # fast, expressive voices that laugh; without: OpenAI's TTS
FISH_API_KEY=         # Fish Audio's voices instead, with TTS_PROVIDER=fish (needs API credit)
JEV_API_KEY=          # fast, calibrated routing (who answers whom); without: an OpenAI model
                      # (TYPESAFE_API_KEY works too)
DEEPGRAM_API_KEY=     # lets the guest clap back out loud; without: typing only
DAILY_API_KEY=        # only for `bot.py -t daily` (a Daily room per session); WebRTC needs none

# Optional
# REHEARSAL=1                   # canned lines instead of the LLM: everything else real, no tokens
# LLM_MODEL=gpt-5.4-mini        # every line the panel says: needs a quick first token
# LLM_REASONING=none
# WRITER_MODEL=gpt-6.1-sol      # the writers' room, once per roast
# WRITER_REASONING=low
# ROUTER_MODEL=gpt-5.4-mini     # routing, without a Jev key
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# TTS_PROVIDER=fish             # cartesia, fish or openai: whose voices, given a key for them
# FISH_MODEL=drama-3            # or s2.1-pro: cheaper, bracketed directions only
# OPENAI_BASE_URL=              # an OpenAI-compatible endpoint instead of OpenAI's own
# JEV_MODEL=jev-1.13.0
# BOT_LOG_LEVEL=INFO            # DEBUG adds what was said (INFO keeps it out of the logs)
