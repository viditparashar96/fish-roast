# Where sessions start. Anything set here ends up in the browser bundle: never put secrets in it.
# How sessions connect: smallwebrtc (peer to peer, no account; the bot runs `-t webrtc`) or daily
# (a Daily room per session; the bot runs `-t daily` with DAILY_API_KEY).
VITE_TRANSPORT=smallwebrtc
# Locally, the Pipecat dev runner (cd ../server && uv run bot.py -t webrtc):
VITE_BOT_START_URL=http://localhost:7860/start
# On Pipecat Cloud (VITE_TRANSPORT=daily), the agent's public start endpoint and your
# organisation's *public* API key (pk_…, made for exactly this; never the private one):
# VITE_BOT_START_URL=https://api.pipecat.daily.co/v1/public/roast-room/start
# VITE_PIPECAT_PUBLIC_KEY=pk_...
